[Desktop Entry]
Type=Application
Name=Dustshot
Name[zh_CN]=Dustshot 截图
Comment=Wayland screenshot, annotation, OCR and pinboard tool
Comment[zh_CN]=Wayland 截图、标注、文字识别与贴图工具
Exec=dustshot region
Icon=io.github.publieople.Dustshot
Terminal=false
Categories=Graphics;
Keywords=screenshot;capture;annotate;ocr;pin;wayland;
Keywords[zh_CN]=截图;标注;文字识别;贴图;
StartupNotify=true
StartupWMClass=io.github.publieople.Dustshot.gui
Actions=full;edit;record;ocr;history;

[Desktop Action full]
Name=Capture every output
Name[zh_CN]=截取全部输出
Exec=dustshot full --no-editor

[Desktop Action edit]
Name=Open the editor on a file
Name[zh_CN]=编辑已有图片
Exec=dustshot edit %f

[Desktop Action record]
Name=Record a region
Name[zh_CN]=录制屏幕区域
Exec=dustshot record

[Desktop Action ocr]
Name=Recognise text in a region
Name[zh_CN]=识别区域文字
Exec=dustshot ocr --copy

[Desktop Action history]
Name=Browse capture history
Name[zh_CN]=浏览截图历史
Exec=dustshot history --gui
