#: src/dustshot/cli.py:599
msgid ""
"# GNOME：设置 -> 键盘 -> 自定义快捷键\n"
"名称: Dustshot 截图    命令: dustshot region    按键: Super+Shift+S\n"
"名称: Dustshot 全屏    命令: dustshot full      按键: Super+Shift+F\n"
"名称: Dustshot 取字    命令: dustshot ocr       按键: Super+Shift+O\n"
"名称: Dustshot 录制    命令: dustshot record --gif   按键: Super+Shift+R"
msgstr ""
"# GNOME: Settings -> Keyboard -> Custom Shortcuts\n"
"Name: Dustshot region    Command: dustshot region    Shortcut: "
"Super+Shift+S\n"
"Name: Dustshot full      Command: dustshot full      Shortcut: "
"Super+Shift+F\n"
"Name: Dustshot text      Command: dustshot ocr       Shortcut: "
"Super+Shift+O\n"
"Name: Dustshot record    Command: dustshot record --gif   Shortcut: "
"Super+Shift+R"

#: src/dustshot/cli.py:604
msgid ""
"# 系统设置 -> 快捷键 -> 自定义快捷键 -> 新建 -> 命令/URL\n"
"动作: Dustshot 截图   触发器: Meta+Shift+S   命令: dustshot region\n"
"动作: Dustshot 全屏   触发器: Meta+Shift+F   命令: dustshot full\n"
"动作: Dustshot 取字   触发器: Meta+Shift+O   命令: dustshot ocr\n"
"动作: Dustshot 录制   触发器: Meta+Shift+R   命令: dustshot record --gif"
msgstr ""
"# System Settings -> Shortcuts -> Custom Shortcuts -> New -> Command/URL\n"
"Action: Dustshot region    Trigger: Meta+Shift+S    Command: dustshot "
"region\n"
"Action: Dustshot full      Trigger: Meta+Shift+F    Command: dustshot full\n"
"Action: Dustshot text      Trigger: Meta+Shift+O    Command: dustshot ocr\n"
"Action: Dustshot record    Trigger: Meta+Shift+R    Command: dustshot record "
"--gif"

#: src/dustshot/cli.py:609
