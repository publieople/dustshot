msgid "Wayland 原生的截图、标注与贴图工具"
msgstr "A native Wayland screenshot, annotation and pinning tool"

#: src/catchlight/cli.py:25
msgid ""
"常用示例：\n"
"    catchlight                         框选截图并打开编辑器\n"
"    catchlight full                    截取全部输出\n"
"    catchlight region --pin            框选后直接钉在屏幕上\n"
"    catchlight ocr                     框选后识别文字\n"
"    catchlight record --gif            框选后录制并转 GIF\n"
"    catchlight pin shot.png            把已有图片钉在屏幕上\n"
"    catchlight codes                   框选并识别二维码/条码\n"
"    catchlight redact                 框选并自动遮住敏感信息\n"
"    catchlight scroll --steps 4         滚动截图并拼接成长图\n"
"    catchlight history --gui           浏览截图历史\n"
"    catchlight tray                   在系统托盘里驻留一个图标\n"
"    catchlight doctor                  检查运行环境\n"
msgstr "Common examples:\n"
"    catchlight                         select a region and open the editor\n"
"    catchlight full                    capture every output\n"
"    catchlight region --pin            select a region and pin it right away\n"
"    catchlight ocr                     select a region and recognise its text\n"
"    catchlight record --gif            select a region, record and convert to GIF\n"
"    catchlight pin shot.png            pin an existing image on screen\n"
"    catchlight codes                   select a region and read QR codes and barcodes\n"
"    catchlight redact                  select a region and cover sensitive text\n"
"    catchlight scroll --steps 4         capture a long page and stitch it\n"
"    catchlight history --gui           browse the capture history\n"
"    catchlight tray                    keep an icon in the system tray\n"
"    catchlight doctor                  check the runtime environment\n"
""

