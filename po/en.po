#: src/dustshot/cli.py:23 src/dustshot/tray.py:19
msgid "Wayland 原生的截图、标注与贴图工具"
msgstr "A native Wayland screenshot, annotation and pinning tool"

#: src/dustshot/cli.py:25
msgid ""
"常用示例：\n"
"    dustshot                         框选截图并打开编辑器\n"
"    dustshot full                    截取全部输出\n"
"    dustshot region --pin            框选后直接钉在屏幕上\n"
"    dustshot ocr                     框选后识别文字\n"
"    dustshot record --gif            框选后录制并转 GIF\n"
"    dustshot pin shot.png            把已有图片钉在屏幕上\n"
"    dustshot codes                   框选并识别二维码/条码\n"
"    dustshot redact                 框选并自动遮住敏感信息\n"
"    dustshot scroll --steps 4         滚动截图并拼接成长图\n"
"    dustshot history --gui           浏览截图历史\n"
"    dustshot tray                   在系统托盘里驻留一个图标\n"
"    dustshot doctor                  检查运行环境\n"
msgstr ""
"Common examples:\n"
"    dustshot                         select a region and open the editor\n"
"    dustshot full                    capture every output\n"
"    dustshot region --pin            select a region and pin it right away\n"
"    dustshot ocr                     select a region and recognise its text\n"
"    dustshot record --gif            select a region, record and convert to "
"GIF\n"
"    dustshot pin shot.png            pin an existing image on screen\n"
"    dustshot codes                   select a region and read QR codes and "
"barcodes\n"
"    dustshot redact                  select a region and cover sensitive "
"text\n"
"    dustshot scroll --steps 4         capture a long page and stitch it\n"
"    dustshot history --gui           browse the capture history\n"
"    dustshot tray                    keep an icon in the system tray\n"
"    dustshot doctor                  check the runtime environment\n"

