#: src/catchlight/cli.py:594
msgid ""
"# GNOME：设置 -> 键盘 -> 自定义快捷键\n"
"名称: Catchlight 截图    命令: catchlight region    按键: Super+Shift+S\n"
"名称: Catchlight 全屏    命令: catchlight full      按键: Super+Shift+F\n"
"名称: Catchlight 取字    命令: catchlight ocr       按键: Super+Shift+O\n"
"名称: Catchlight 录制    命令: catchlight record --gif   按键: Super+Shift+R"
msgstr "# GNOME: Settings -> Keyboard -> Custom Shortcuts\n"
"Name: Catchlight region    Command: catchlight region    Shortcut: Super+Shift+S\n"
"Name: Catchlight full      Command: catchlight full      Shortcut: Super+Shift+F\n"
"Name: Catchlight text      Command: catchlight ocr       Shortcut: Super+Shift+O\n"
"Name: Catchlight record    Command: catchlight record --gif   Shortcut: Super+Shift+R"

#: src/catchlight/cli.py:599
msgid ""
"# 系统设置 -> 快捷键 -> 自定义快捷键 -> 新建 -> 命令/URL\n"
